AUTH_MODE=hybrid
OIDC_ENABLED=true
OIDC_PROVIDER_NAME=Oracle SSO
OIDC_ISSUER=https://your-oracle-identity-domain
OIDC_CLIENT_ID=fill-your-client-id
OIDC_CLIENT_SECRET=fill-your-client-secret
OIDC_REDIRECT_URI=http://your-host:3210/auth/callback
OIDC_POST_LOGOUT_REDIRECT_URI=http://your-host:3210/login
OIDC_REGISTRATION_URL=https://your-access-request-page
OIDC_SUPPORT_URL=https://your-password-help-page
OIDC_SCOPE=openid profile email
OIDC_COOKIE_SECRET=fill-a-long-random-server-secret
OIDC_SESSION_TTL_HOURS=12
