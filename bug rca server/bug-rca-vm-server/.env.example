# Temporary or environment-specific VM host for the hosted UI.
# Change this value when your VM host changes.
BUG_RCA_VM_BASE_URL=http://your-vm-host:3210

# This server now auto-loads .env from the VM package root before startup.
# Keep real secrets here instead of hardcoding them into mcp-servers.json.

# Optional Codex API-key provider settings for hosted VM runs.
# Use either codex login for the VM user, or one of these API-key modes.
# OPENAI_API_KEY=your-openai-api-key
# CODEX_API_KEY=your-generic-openai-compatible-key
# ORACLE_CODE_ASSIST_API_KEY=your-oca-api-key
# OCA_API_KEY=your-oca-api-key
# OPENAI_BASE_URL=https://api.openai.com/v1
# CODEX_BASE_URL=https://your-openai-compatible-endpoint/v1
# ORACLE_CODE_ASSIST_BASE_URL=https://code-internal.aiservice.us-chicago-1.oci.oraclecloud.com/20250206/app/litellm
# OCA_BASE_URL=https://code-internal.aiservice.us-chicago-1.oci.oraclecloud.com/20250206/app/litellm
# CODEX_MODEL_PROVIDER=oracle-code-assist
# CODEX_PROVIDER_ID=oca
# ORACLE_CODE_ASSIST_MODEL=gpt5
# ORACLE_CODE_ASSIST_HTTP_HEADERS={"client":"codex-cli","client-version":"0"}

# Optional Jira MCP tokens referenced by mcp-servers.json command templates.
# JIRA_OCI_PERSONAL_TOKEN=your-jira-oci-pat
# JIRA_CENTRAL_PERSONAL_TOKEN=your-jira-central-pat
# GBUJIRA_PERSONAL_TOKEN=your-gbujira-pat

# Optional hosted shared workspace roots for shared:// descriptors.
# Supports absolute paths, app-relative paths, and env expansion such as %USERPROFILE%, ${USERPROFILE}, or $USERPROFILE.
# Define one entry per product root. Each entry can list multiple candidate folders, such as VM checkouts under C:\code
# and user-local workspaces. The first existing folder is used for that product.
# Example:
# SHARED_WORKSPACE_ROOTS=[{"id":"simphony","aliases":["simphony-temp"],"label":"Simphony Shared Workspace","rootPath":["C:\\code\\simphony","C:\\Simphony","%USERPROFILE%\\workspace\\simphony"],"productKey":"simphony"},{"id":"rna","label":"R&A Shared Workspace","rootPath":["C:\\code\\rna","%USERPROFILE%\\workspace\\rna"],"productKey":"rna"},{"id":"flm","label":"FLM Shared Workspace","rootPath":["C:\\code\\flm","%USERPROFILE%\\workspace\\flm"],"productKey":"flm"}]

# Optional startup behavior for hosted shared workspaces.
# When SHARED_WORKSPACE_ROOTS is configured, the VM startup task will regenerate AGENTS.md and
# docs/memory-bank/index.md inside each resolved shared checkout by running references/generate-memory-bank-FINAL.md with Codex.
# Set this to false to skip that generation during server startup.
# GENERATE_SHARED_MEMORY_BANKS_ON_STARTUP=true

